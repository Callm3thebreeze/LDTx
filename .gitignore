# ====================
# MONOREPO GITIGNORE
# ====================

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage
.grunt

# Bower dependency directory
bower_components

# ====================
# FRONTEND (ASTRO)
# ====================

# Astro build outputs
frontend/dist/
frontend/.astro/

# Generated types
frontend/.astro/types.d.ts

# Dependencies
frontend/node_modules/

# Environment variables
frontend/.env
frontend/.env.local
frontend/.env.*.local

# MacOS-specific files
frontend/.DS_Store

# ====================
# BACKEND (STRAPI)
# ====================

# Strapi build outputs
backend/build/
backend/dist/

# Database
backend/.tmp/
backend/data.db*
backend/database/

# Environment variables
backend/.env
backend/.env.*

# Strapi generated files
backend/src/api/**/*.js
backend/src/api/**/*.map
backend/src/admin/
backend/.strapi-updater.json

# Strapi dependencies
backend/node_modules/

# Logs
backend/logs
backend/*.log

# Uploads
backend/public/uploads/*
!backend/public/uploads/.gitkeep

# Cache
backend/.cache/

# ====================
# DEVELOPMENT TOOLS
# ====================

# IDEs and editors
.vscode/settings.json
.vscode/launch.json
.vscode/extensions.json
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ====================
# LOGS & DEBUGGING
# ====================

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# ====================
# TEMPORARY FILES
# ====================

# Temporary folders
tmp/
temp/

# ====================
# PACKAGE MANAGERS
# ====================

# Package manager lock files (keep only one)
# Uncomment the ones you DON'T use:
# yarn.lock
# pnpm-lock.yaml

# ====================
# OPTIONAL IGNORES
# ====================

# If using TypeScript compilation cache
*.tsbuildinfo

# If using ESLint cache
.eslintcache

# If using Stylelint cache
.stylelintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# ====================
# BUILD ARTIFACTS
# ====================

# Build directories
build/
dist/
out/

# Static file build
frontend/public/build/

# ====================
# STRAPI SPECIFIC
# ====================

# Strapi license file
backend/license.txt

# Strapi documentation build
backend/docs/

# Strapi cache and temporary files
backend/.cache/
backend/exports/
backend/*.cache
backend/.strapi-updater.json
backend/.strapi/

# Strapi uploads (uncomment if you want to version uploads)
# backend/public/uploads/
