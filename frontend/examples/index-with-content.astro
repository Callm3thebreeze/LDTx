---
// Ejemplo de cómo usar el contenido centralizado en index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import ProductCard from '../components/ProductCard.astro';
import {
  getSiteContent,
  getFeaturedBlogPosts,
  getFeaturedProducts,
} from '../utils/content';

// Cargar contenido centralizado
const siteContent = await getSiteContent();
const featuredPosts = await getFeaturedBlogPosts();
const featuredProducts = await getFeaturedProducts();

const { hero, sections } = siteContent;
---

<BaseLayout
  title='LDTx - Tu guía para una vida saludable'
  description='Descubre productos saludables y consejos para transformar tu bienestar. Blog especializado en cocina saludable y productos afiliados cuidadosamente seleccionados.'
>
  <!-- Hero Section -->
  <section
    class='bg-gradient-to-br from-primary-50 to-primary-100 py-16 lg:py-24'
  >
    <div class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8'>
      <div class='text-center'>
        <h1 class='hero-title text-gray-900 mb-6'>
          {hero.title}
          <span class='text-primary-600'>{hero.titleHighlight}</span>
        </h1>
        <p class='lead-text text-gray-600 mb-8 max-w-3xl mx-auto'>
          {hero.subtitle}
        </p>
        <div class='flex flex-col sm:flex-row gap-4 justify-center'>
          {
            hero.ctaButtons.map((button) => (
              <a
                href={button.href}
                class={
                  button.style === 'primary'
                    ? 'btn-primary btn-large'
                    : 'btn-outline-secondary btn-large'
                }
              >
                {button.text}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Blog Section -->
  <section class='py-16 bg-white'>
    <div class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8'>
      <div class='text-center mb-12'>
        <h2 class='title-section text-gray-900 mb-4'>
          {sections.blog.title}
        </h2>
        <p class='body-text text-gray-600 max-w-2xl mx-auto'>
          {sections.blog.subtitle}
        </p>
      </div>

      <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-8'>
        {featuredPosts.map((post) => <BlogCard post={post} />)}

        <!-- Teaser card para más artículos -->
        <div class='card'>
          <div class='card-body text-center'>
            <h3 class='card-title'>
              {sections.blog.moreArticles.title}
            </h3>
            <p class='card-description'>
              {sections.blog.moreArticles.description}
            </p>
            <a href='/blog/' class='btn-primary'>
              {sections.blog.moreArticles.ctaText}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Products Section -->
  <section class='py-16 bg-gray-50'>
    <div class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8'>
      <div class='text-center mb-12'>
        <h2 class='title-section text-gray-900 mb-4'>
          {sections.products.title}
        </h2>
        <p class='body-text text-gray-600 max-w-2xl mx-auto'>
          {sections.products.subtitle}
        </p>
      </div>

      <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-8'>
        {featuredProducts.map((product) => <ProductCard product={product} />)}

        <!-- Teaser card para más productos -->
        <div class='card'>
          <div class='card-body text-center'>
            <h3 class='card-title'>
              {sections.products.catalogComplete.title}
            </h3>
            <p class='card-description'>
              {sections.products.catalogComplete.description}
            </p>
            <a href='/productos/' class='btn-primary'>
              {sections.products.catalogComplete.ctaText}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class='py-16 bg-primary-600'>
    <div class='max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center'>
      <h2 class='title-section text-white mb-4'>
        {sections.cta.title}
      </h2>
      <p class='lead-text text-primary-100 mb-8'>
        {sections.cta.subtitle}
      </p>
      <a href='/contacto/' class='btn-outline-secondary btn-large'>
        {sections.cta.ctaText}
      </a>
    </div>
  </section>
</BaseLayout>
