---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getBlogPosts } from '../../utils/content';

// Cargar posts desde Strapi
const blogPosts = await getBlogPosts();

// Solo mostrar posts que existen en la base de datos
if (!blogPosts || blogPosts.length === 0) {
  console.log('No hay posts disponibles en la base de datos');
}

// Agrupar posts por categoría (solo si hay posts)
const categories = blogPosts.length > 0 
  ? [...new Set(blogPosts.map((post) => post.category))]
  : [];

const postsByCategory = categories.reduce(
  (acc, category) => {
    acc[category] = blogPosts.filter((post) => post.category === category);
    return acc;
  },
  {} as Record<string, any[]>
);

// Posts destacados (featured)
const featuredPosts = blogPosts.filter(post => post.featured);
---

<BaseLayout
  title='Blog - Consejos para una vida saludable'
  description='Descubre consejos, guías y recomendaciones sobre cocina saludable, nutrición y bienestar. Artículos escritos por expertos para transformar tu estilo de vida.'
>
  <div class='bg-primary-50 py-12'>
    <div class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8'>
      <div class='text-center'>
        <h1 class='title-main text-gray-900 mb-4'>Blog de vida saludable</h1>
        <p class='lead-text text-gray-600 max-w-2xl mx-auto'>
          Consejos, guías y recomendaciones para llevar un estilo de vida más
          saludable y consciente
        </p>
      </div>
    </div>
  </div>

  <div class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12'>
    {blogPosts.length === 0 ? (
      <!-- Mensaje cuando no hay posts -->
      <div class="text-center py-16">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">No hay artículos disponibles</h2>
        <p class="text-gray-600 mb-8">
          Aún no se han publicado artículos en el blog. ¡Vuelve pronto para ver contenido nuevo!
        </p>
        <a href="/" class="bg-primary-600 hover:bg-primary-700 text-white px-6 py-3 rounded-lg transition-colors">
          Volver al inicio
        </a>
      </div>
    ) : (
      <>
        <!-- Categorías dinámicas -->
        {categories.length > 0 && (
          <div class='mb-8'>
            <h2 class='text-2xl font-bold text-gray-900 mb-4'>Categorías</h2>
            <div class='flex flex-wrap gap-2'>
              <a
                href='/blog/'
                class='bg-primary-100 hover:bg-primary-200 text-primary-800 px-4 py-2 rounded-full text-sm font-medium transition-colors'
              >
                Todos los artículos ({blogPosts.length})
              </a>
              {categories.map((category) => (
                <a
                  href={`/blog/${category}/`}
                  class='bg-gray-100 hover:bg-gray-200 text-gray-800 px-4 py-2 rounded-full text-sm font-medium transition-colors capitalize'
                >
                  {category} ({postsByCategory[category].length})
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Artículo destacado -->
        {featuredPosts.length > 0 && (
          <section class='mb-12'>
            <h2 class='text-2xl font-bold text-gray-900 mb-6'>
              Artículo destacado
            </h2>
            <div class='grid grid-cols-1 lg:grid-cols-2 gap-8'>
              <BlogCard
                post={featuredPosts[0]}
                featured={true}
              />
            </div>
          </section>
        )}

        <!-- Todos los artículos -->
        <section>
          <h2 class='text-2xl font-bold text-gray-900 mb-6'>
            Todos los artículos ({blogPosts.length})
          </h2>
          <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8'>
            {blogPosts.map((post) => <BlogCard post={post} />)}
          </div>
        </section>
      </>
    )}
  </div>

    <!-- Paginación (placeholder) -->
    <div class='mt-12 flex justify-center'>
      <nav class='flex space-x-2'>
        <span class='bg-primary-600 text-white px-4 py-2 rounded-lg'>1</span>
        <a
          href='/blog/page/2/'
          class='bg-gray-100 hover:bg-gray-200 text-gray-800 px-4 py-2 rounded-lg transition-colors'
          >2</a
        >
        <a
          href='/blog/page/3/'
          class='bg-gray-100 hover:bg-gray-200 text-gray-800 px-4 py-2 rounded-lg transition-colors'
          >3</a
        >
      </nav>
    </div>
  </div>
</BaseLayout>
