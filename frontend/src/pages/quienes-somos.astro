---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPageContent } from '../utils/content';

// Cargar contenido de la página
const aboutContent = await getPageContent('about');
---

<BaseLayout
  title='Quiénes Somos - LDTx'
  description='Conoce al equipo de LDTx, nuestra misión y por qué nos dedicamos a promover un estilo de vida saludable a través de productos y contenido de calidad.'
>
  <div class='max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12'>
    <!-- Header -->
    <div class='text-center mb-12'>
      <h1 class='text-4xl md:text-5xl font-bold text-gray-900 mb-6'>
        {aboutContent.title}
      </h1>
      <p class='text-xl text-gray-600 max-w-2xl mx-auto'>
        {aboutContent.subtitle}
        Somos un equipo apasionado por la vida saludable, dedicado a ayudarte a tomar
        mejores decisiones para tu bienestar y el de tu familia.
      </p>
    </div>

    <!-- Nuestra misión -->
    <section class='mb-16'>
      <h2 class='text-3xl font-bold text-gray-900 mb-6'>
        {aboutContent.mission.title}
      </h2>
      <div class='card'>
        <div class='card-body'>
          {
            aboutContent.mission.content.map((paragraph) => (
              <p class='card-description mb-4'>{paragraph}</p>
            ))
          }
          <p class='card-description'>
            Investigamos, probamos y seleccionamos cuidadosamente cada producto
            que recomendamos, siempre priorizando la salud, la sostenibilidad y
            la calidad sobre cualquier consideración comercial.
          </p>
        </div>
      </div>
    </section>

    <!-- Nuestros valores -->
    <section class='mb-16'>
      <h2 class='text-3xl font-bold text-gray-900 mb-8'>Nuestros valores</h2>
      <div class='grid grid-cols-1 md:grid-cols-2 gap-8'>
        {
          aboutContent.values.map((value) => (
            <div class='card'>
              <div class='card-body'>
                <div class='flex items-center mb-4'>
                  <span class='text-2xl mr-3'>{value.icon}</span>
                  <h3 class='card-title'>{value.title}</h3>
                </div>
                <p class='card-description'>{value.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>
    <!-- Nuestro proceso -->
    <section class='mb-16'>
      <h2 class='text-3xl font-bold text-gray-900 mb-8'>
        {aboutContent.process.title}
      </h2>
      <div class='space-y-6'>
        {
          aboutContent.process.steps.map((step) => (
            <div class='flex items-start'>
              <span class='flex-shrink-0 w-8 h-8 bg-primary-600 text-white rounded-full flex items-center justify-center text-sm font-bold mr-4'>
                {step.number}
              </span>
              <div>
                <h3 class='text-lg font-semibold text-gray-900 mb-2'>
                  {step.title}
                </h3>
                <p class='text-gray-600'>{step.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Nuestro compromiso -->
    <section class='mb-16'>
      <h2 class='text-3xl font-bold text-gray-900 mb-6'>
        Nuestro compromiso contigo
      </h2>
      <div class='bg-gray-50 rounded-lg p-8'>
        <ul class='space-y-4'>
          <li class='flex items-start'>
            <span class='text-primary-600 mr-3'>✓</span>
            <span class='text-gray-700'>
              <strong>Independencia editorial:</strong> Nuestro contenido nunca está
              influenciado por consideraciones comerciales.
            </span>
          </li>
          <li class='flex items-start'>
            <span class='text-primary-600 mr-3'>✓</span>
            <span class='text-gray-700'>
              <strong>Actualizaciones constantes:</strong> Revisamos y actualizamos
              nuestras recomendaciones regularmente.
            </span>
          </li>
          <li class='flex items-start'>
            <span class='text-primary-600 mr-3'>✓</span>
            <span class='text-gray-700'>
              <strong>Soporte al cliente:</strong> Estamos aquí para responder tus
              preguntas y ayudarte en tu proceso de decisión.
            </span>
          </li>
          <li class='flex items-start'>
            <span class='text-primary-600 mr-3'>✓</span>
            <span class='text-gray-700'>
              <strong>Transparencia total:</strong> Declaramos claramente todas nuestras
              afiliaciones y fuentes de ingresos.
            </span>
          </li>
        </ul>
      </div>
    </section>

    <!-- Call to action -->
    <section class='text-center bg-primary-600 text-white rounded-lg p-8'>
      <h2 class='text-2xl font-bold mb-4'>¿Tienes alguna pregunta?</h2>
      <p class='text-primary-100 mb-6'>
        Nos encantaría conocerte y ayudarte en tu camino hacia una vida más
        saludable.
      </p>
      <a
        href='/contacto/'
        class='bg-white hover:bg-gray-100 text-primary-600 font-semibold py-3 px-6 rounded-lg transition-colors inline-block'
      >
        Contáctanos
      </a>
    </section>
  </div>
</BaseLayout>
