{
  "extends": "./frontend/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@frontend/*": ["./frontend/src/*"],
      "@backend/*": ["./backend/src/*"]
    }
  },
  "include": ["frontend/**/*", "backend/**/*"],
  "exclude": [
    "node_modules",
    "frontend/node_modules",
    "backend/node_modules",
    "frontend/dist",
    "backend/dist",
    "backend/build"
  ]
}
