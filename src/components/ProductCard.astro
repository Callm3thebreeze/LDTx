---
import type { Product } from '../types';

export interface Props {
  product: Product;
  featured?: boolean;
}

const { product, featured = false } = Astro.props;
---

<article
  class={`card hover:shadow-lg transition-shadow ${featured ? 'md:col-span-2' : ''}`}
>
  <div class='aspect-square overflow-hidden relative'>
    <img
      src={product.image}
      alt={product.name}
      class='w-full h-full object-cover hover:scale-105 transition-transform duration-300'
    />
    {
      product.originalPrice && (
        <div class='absolute top-2 left-2 badge-highlight'>
          -
          {Math.round(
            ((product.originalPrice - product.price) / product.originalPrice) *
              100
          )}
          %
        </div>
      )
    }
    {
      product.featured && (
        <div class='absolute top-2 right-2 badge-secondary'>Destacado</div>
      )
    }
  </div>

  <div class='card-body'>
    <div class='meta-text mb-2'>
      <span class='badge-primary'>
        {product.category}
      </span>
      {
        product.rating && (
          <>
            <span class='mx-2'>•</span>
            <div class='flex items-center'>
              <span class='text-yellow-400'>★</span>
              <span class='ml-1'>{product.rating}</span>
              {product.reviews && (
                <span class='text-gray-400 ml-1'>({product.reviews})</span>
              )}
            </div>
          </>
        )
      }
    </div>

    <h3 class='card-title hover:text-primary-600 transition-colors'>
      <a href={`/producto/${product.slug}/`}>
        {product.name}
      </a>
    </h3>

    <p class='card-description mb-3 line-clamp-2'>
      {product.description}
    </p>

    <div class='flex items-center justify-between mb-3'>
      <div class='flex items-center space-x-2'>
        <span class='text-2xl font-bold text-primary-600'>
          {product.price.toFixed(2)}€
        </span>
        {
          product.originalPrice && (
            <span class='text-lg text-gray-400 line-through'>
              {product.originalPrice.toFixed(2)}€
            </span>
          )
        }
      </div>

      <span
        class={`text-xs px-2 py-1 rounded-full ${
          product.inStock
            ? 'bg-accent-100 text-accent-800'
            : 'bg-highlight-100 text-highlight-800'
        }`}
      >
        {product.inStock ? 'En stock' : 'Agotado'}
      </span>
    </div>

    <div class='flex space-x-2'>
      <a
        href={`/producto/${product.slug}/`}
        class='flex-1 btn-ghost text-center text-sm'
      >
        Ver detalles
      </a>
      <a
        href={product.affiliateLink}
        target='_blank'
        rel='nofollow noopener'
        class='flex-1 btn-secondary text-center text-sm'
      >
        Comprar
      </a>
    </div>
  </div>
</article>
