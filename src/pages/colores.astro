---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title='Guía de Colores - LDTx'
  description='Guía visual de la nueva paleta de colores de LDTx'
>
  <div class='max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12'>
    <h1 class='text-4xl font-bold text-gray-900 mb-8'>Guía de Colores LDTx</h1>

    <!-- Primary Colors -->
    <section class='mb-12'>
      <h2 class='text-2xl font-bold text-gray-900 mb-6'>
        🔵 Primary - Azul Principal (#0042AC)
      </h2>
      <div class='grid grid-cols-2 md:grid-cols-5 gap-4 mb-6'>
        <div class='bg-primary-50 p-4 rounded-lg text-center'>
          <div class='text-xs text-gray-600 mb-1'>50</div>
          <div class='text-xs text-gray-800'>#eff6ff</div>
        </div>
        <div class='bg-primary-100 p-4 rounded-lg text-center'>
          <div class='text-xs text-gray-600 mb-1'>100</div>
          <div class='text-xs text-gray-800'>#dbeafe</div>
        </div>
        <div class='bg-primary-300 p-4 rounded-lg text-center text-white'>
          <div class='text-xs mb-1'>300</div>
          <div class='text-xs'>#93c5fd</div>
        </div>
        <div class='bg-primary-600 p-4 rounded-lg text-center text-white'>
          <div class='text-xs mb-1'>600 ⭐</div>
          <div class='text-xs'>#0042AC</div>
        </div>
        <div class='bg-primary-900 p-4 rounded-lg text-center text-white'>
          <div class='text-xs mb-1'>900</div>
          <div class='text-xs'>#001d5b</div>
        </div>
      </div>

      <!-- Ejemplos de uso -->
      <div class='space-y-4'>
        <button
          class='bg-primary-600 hover:bg-primary-700 text-white font-semibold py-3 px-6 rounded-lg transition-colors'
        >
          Botón Principal
        </button>
        <div class='bg-primary-50 p-4 rounded-lg'>
          <span
            class='bg-primary-100 text-primary-800 px-3 py-1 rounded-full text-sm font-medium'
          >
            Tag Primary
          </span>
        </div>
      </div>
    </section>

    <!-- Secondary Colors -->
    <section class='mb-12'>
      <h2 class='text-2xl font-bold text-gray-900 mb-6'>
        🔷 Secondary - Azul Claro (#2F7EFE)
      </h2>
      <div class='grid grid-cols-2 md:grid-cols-5 gap-4 mb-6'>
        <div class='bg-secondary-50 p-4 rounded-lg text-center'>
          <div class='text-xs text-gray-600 mb-1'>50</div>
          <div class='text-xs text-gray-800'>#f0f9ff</div>
        </div>
        <div class='bg-secondary-100 p-4 rounded-lg text-center'>
          <div class='text-xs text-gray-600 mb-1'>100</div>
          <div class='text-xs text-gray-800'>#e0f2fe</div>
        </div>
        <div class='bg-secondary-300 p-4 rounded-lg text-center text-white'>
          <div class='text-xs mb-1'>300</div>
          <div class='text-xs'>#7dd3fc</div>
        </div>
        <div class='bg-secondary-500 p-4 rounded-lg text-center text-white'>
          <div class='text-xs mb-1'>500 ⭐</div>
          <div class='text-xs'>#2F7EFE</div>
        </div>
        <div class='bg-secondary-900 p-4 rounded-lg text-center text-white'>
          <div class='text-xs mb-1'>900</div>
          <div class='text-xs'>#0c4a6e</div>
        </div>
      </div>

      <!-- Ejemplos de uso -->
      <div class='space-y-4'>
        <div class='bg-secondary-50 p-6 rounded-lg'>
          <h3 class='text-lg font-semibold text-gray-900 mb-2'>
            Sección Informativa
          </h3>
          <p class='text-gray-600'>
            Ideal para backgrounds de secciones y elementos informativos.
          </p>
        </div>
        <button
          class='bg-secondary-500 hover:bg-secondary-600 text-white font-semibold py-3 px-6 rounded-lg transition-colors'
        >
          Botón Secondary
        </button>
      </div>
    </section>

    <!-- Highlight Colors -->
    <section class='mb-12'>
      <h2 class='text-2xl font-bold text-gray-900 mb-6'>
        🔴 Highlight - Rojo de Acción (#ED4A44)
      </h2>
      <div class='grid grid-cols-2 md:grid-cols-5 gap-4 mb-6'>
        <div class='bg-highlight-50 p-4 rounded-lg text-center'>
          <div class='text-xs text-gray-600 mb-1'>50</div>
          <div class='text-xs text-gray-800'>#fef2f2</div>
        </div>
        <div class='bg-highlight-100 p-4 rounded-lg text-center'>
          <div class='text-xs text-gray-600 mb-1'>100</div>
          <div class='text-xs text-gray-800'>#fee2e2</div>
        </div>
        <div class='bg-highlight-300 p-4 rounded-lg text-center text-white'>
          <div class='text-xs mb-1'>300</div>
          <div class='text-xs'>#fca5a5</div>
        </div>
        <div class='bg-highlight-500 p-4 rounded-lg text-center text-white'>
          <div class='text-xs mb-1'>500 ⭐</div>
          <div class='text-xs'>#ED4A44</div>
        </div>
        <div class='bg-highlight-900 p-4 rounded-lg text-center text-white'>
          <div class='text-xs mb-1'>900</div>
          <div class='text-xs'>#7f1d1d</div>
        </div>
      </div>

      <!-- Ejemplos de uso -->
      <div class='space-y-4'>
        <button
          class='bg-highlight-500 hover:bg-highlight-600 text-white font-semibold py-3 px-6 rounded-lg transition-colors'
        >
          ¡Comprar Ahora!
        </button>
        <div class='bg-highlight-50 border border-highlight-200 p-4 rounded-lg'>
          <span
            class='bg-highlight-100 text-highlight-800 px-3 py-1 rounded-full text-sm font-medium'
          >
            Oferta Especial -25%
          </span>
        </div>
      </div>
    </section>

    <!-- Accent Colors -->
    <section class='mb-12'>
      <h2 class='text-2xl font-bold text-gray-900 mb-6'>
        🟢 Accent - Verde Natural (#16a34a)
      </h2>
      <div class='grid grid-cols-2 md:grid-cols-5 gap-4 mb-6'>
        <div class='bg-accent-50 p-4 rounded-lg text-center'>
          <div class='text-xs text-gray-600 mb-1'>50</div>
          <div class='text-xs text-gray-800'>#f0fdf4</div>
        </div>
        <div class='bg-accent-100 p-4 rounded-lg text-center'>
          <div class='text-xs text-gray-600 mb-1'>100</div>
          <div class='text-xs text-gray-800'>#dcfce7</div>
        </div>
        <div class='bg-accent-300 p-4 rounded-lg text-center text-white'>
          <div class='text-xs mb-1'>300</div>
          <div class='text-xs'>#86efac</div>
        </div>
        <div class='bg-accent-600 p-4 rounded-lg text-center text-white'>
          <div class='text-xs mb-1'>600 ⭐</div>
          <div class='text-xs'>#16a34a</div>
        </div>
        <div class='bg-accent-900 p-4 rounded-lg text-center text-white'>
          <div class='text-xs mb-1'>900</div>
          <div class='text-xs'>#14532d</div>
        </div>
      </div>

      <!-- Ejemplos de uso -->
      <div class='space-y-4'>
        <div class='bg-accent-50 border border-accent-200 p-4 rounded-lg'>
          <span
            class='bg-accent-100 text-accent-800 px-3 py-1 rounded-full text-sm font-medium'
          >
            ✅ En Stock
          </span>
          <span
            class='bg-accent-100 text-accent-800 px-3 py-1 rounded-full text-sm font-medium ml-2'
          >
            🌱 Eco-Friendly
          </span>
        </div>
        <button
          class='bg-accent-600 hover:bg-accent-700 text-white font-semibold py-3 px-6 rounded-lg transition-colors'
        >
          Producto Natural
        </button>
      </div>
    </section>

    <!-- Combinaciones -->
    <section class='mb-12'>
      <h2 class='text-2xl font-bold text-gray-900 mb-6'>
        🎨 Combinaciones Recomendadas
      </h2>

      <div class='grid md:grid-cols-2 gap-8'>
        <!-- Card de Producto -->
        <div class='bg-white border border-gray-200 rounded-lg overflow-hidden'>
          <div class='h-32 bg-secondary-100 flex items-center justify-center'>
            <span class='text-secondary-600 font-medium'
              >Imagen del Producto</span
            >
          </div>
          <div class='p-4'>
            <div class='flex items-center justify-between mb-2'>
              <span
                class='bg-primary-100 text-primary-800 px-2 py-1 rounded-full text-xs font-medium'
              >
                Cocina
              </span>
              <span
                class='bg-highlight-100 text-highlight-800 px-2 py-1 rounded-full text-xs font-medium'
              >
                -20%
              </span>
            </div>
            <h3 class='font-semibold text-gray-900 mb-2'>
              Sartén Cerámica Premium
            </h3>
            <div class='flex items-center justify-between mb-3'>
              <div class='flex items-center space-x-2'>
                <span class='text-lg font-bold text-primary-600'>59.99€</span>
                <span class='text-sm text-gray-400 line-through'>79.99€</span>
              </div>
              <span
                class='bg-accent-100 text-accent-800 px-2 py-1 rounded-full text-xs font-medium'
              >
                En stock
              </span>
            </div>
            <button
              class='w-full bg-primary-600 hover:bg-primary-700 text-white font-medium py-2 px-4 rounded transition-colors'
            >
              Ver Producto
            </button>
          </div>
        </div>

        <!-- Card de Blog -->
        <div class='bg-white border border-gray-200 rounded-lg overflow-hidden'>
          <div class='h-32 bg-accent-50 flex items-center justify-center'>
            <span class='text-accent-600 font-medium'>Imagen del Artículo</span>
          </div>
          <div class='p-4'>
            <div class='flex items-center mb-2'>
              <span
                class='bg-secondary-100 text-secondary-800 px-2 py-1 rounded-full text-xs font-medium'
              >
                Consejos
              </span>
            </div>
            <h3 class='font-semibold text-gray-900 mb-2'>
              Cocina Saludable: Guía Completa
            </h3>
            <p class='text-gray-600 text-sm mb-3'>
              Descubre los mejores consejos para una alimentación más
              saludable...
            </p>
            <a
              href='#'
              class='text-primary-600 hover:text-primary-700 font-medium text-sm transition-colors'
            >
              Leer más →
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
