---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductCard from '../../../components/ProductCard.astro';
import type { Product } from '../../../types';

// Productos de cocina
const cocinaProducts: Product[] = [
  {
    id: '1',
    name: 'Sartén Cerámica Premium 28cm',
    description:
      'Sartén antiadherente de cerámica libre de PFOA y PTFE. Perfecta para una cocina saludable.',
    category: 'cocina',
    subcategory: 'sartenes',
    slug: 'sarten-ceramica-premium-28cm',
    price: 59.99,
    originalPrice: 79.99,
    affiliateLink: 'https://ejemplo.com/sarten-ceramica',
    image:
      'https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?w=600&h=600&fit=crop',
    rating: 4.8,
    reviews: 124,
    features: [
      'Libre de tóxicos',
      'Fácil limpieza',
      'Distribución uniforme del calor',
    ],
    tags: ['cerámica', 'antiadherente', 'saludable'],
    inStock: true,
    featured: true,
  },
  {
    id: '2',
    name: 'Sartén de Hierro Fundido 26cm',
    description:
      'Sartén de hierro fundido tradicional. Desarrolla propiedades antiadherentes naturales con el uso.',
    category: 'cocina',
    subcategory: 'sartenes',
    slug: 'sarten-hierro-fundido-26cm',
    price: 89.99,
    affiliateLink: 'https://ejemplo.com/sarten-hierro',
    image:
      'https://images.unsplash.com/photo-1556909045-f3c21bf5a3a8?w=600&h=600&fit=crop',
    rating: 4.9,
    reviews: 67,
    features: [
      '100% natural',
      'Retención excelente del calor',
      'Dura toda la vida',
    ],
    tags: ['hierro fundido', 'tradicional', 'duradero'],
    inStock: true,
  },
  {
    id: '3',
    name: 'Batidora de Vaso Sin BPA',
    description:
      'Batidora de vaso de alta potencia con jarra libre de BPA. Ideal para smoothies y batidos saludables.',
    category: 'cocina',
    subcategory: 'electrodomesticos',
    slug: 'batidora-vaso-sin-bpa',
    price: 149.99,
    originalPrice: 199.99,
    affiliateLink: 'https://ejemplo.com/batidora',
    image:
      'https://images.unsplash.com/photo-1585515656845-3cfe1e19c0d4?w=600&h=600&fit=crop',
    rating: 4.7,
    reviews: 256,
    features: ['Sin BPA', 'Alta potencia', '10 velocidades'],
    tags: ['batidora', 'sin-bpa', 'smoothies'],
    inStock: true,
    featured: true,
  },
  {
    id: '4',
    name: 'Juego de Cuchillos de Acero Inoxidable',
    description:
      'Set completo de cuchillos de acero inoxidable de alta calidad. Incluye tabla de corte de bambú.',
    category: 'cocina',
    subcategory: 'cuchillos',
    slug: 'juego-cuchillos-acero-inoxidable',
    price: 129.99,
    affiliateLink: 'https://ejemplo.com/cuchillos',
    image:
      'https://images.unsplash.com/photo-1593618998160-e34014e67546?w=600&h=600&fit=crop',
    rating: 4.6,
    reviews: 89,
    features: ['Acero japonés', 'Filo duradero', 'Tabla de bambú incluida'],
    tags: ['cuchillos', 'acero inoxidable', 'set completo'],
    inStock: true,
  },
  {
    id: '5',
    name: 'Vaporera de Acero Inoxidable',
    description:
      'Vaporera de 3 niveles para cocinar al vapor de forma saludable. Conserva nutrientes y sabor.',
    category: 'cocina',
    subcategory: 'utensilios',
    slug: 'vaporera-acero-inoxidable',
    price: 79.99,
    affiliateLink: 'https://ejemplo.com/vaporera',
    image:
      'https://images.unsplash.com/photo-1556909045-f3c21bf5a3a8?w=600&h=600&fit=crop',
    rating: 4.5,
    reviews: 45,
    features: ['3 niveles', 'Cocción saludable', 'Fácil limpieza'],
    tags: ['vaporera', 'cocción saludable', 'acero inoxidable'],
    inStock: true,
  },
  {
    id: '6',
    name: 'Tabla de Corte de Bambú Antibacteriana',
    description:
      'Tabla de corte ecológica de bambú con propiedades antibacterianas naturales.',
    category: 'cocina',
    subcategory: 'utensilios',
    slug: 'tabla-corte-bambu-antibacteriana',
    price: 29.99,
    originalPrice: 39.99,
    affiliateLink: 'https://ejemplo.com/tabla-bambu',
    image:
      'https://images.unsplash.com/photo-1556909114-df4d98e29e6d?w=600&h=600&fit=crop',
    rating: 4.7,
    reviews: 156,
    features: ['Bambú sostenible', 'Antibacteriana', 'Resistente a cuchillos'],
    tags: ['bambú', 'ecológico', 'antibacteriana'],
    inStock: true,
  },
];

// Subcategorías
const subcategories = [
  { name: 'Sartenes', slug: 'sartenes', count: 2 },
  { name: 'Electrodomésticos', slug: 'electrodomesticos', count: 1 },
  { name: 'Cuchillos', slug: 'cuchillos', count: 1 },
  { name: 'Utensilios', slug: 'utensilios', count: 2 },
];
---

<BaseLayout
  title='Productos de Cocina Saludable - LDTx'
  description='Descubre nuestra selección de productos de cocina saludable: sartenes sin teflón, electrodomésticos libres de BPA, utensilios seguros y más.'
>
  <div class='bg-secondary-50 py-12'>
    <div class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8'>
      <div class='text-center'>
        <nav class='mb-4'>
          <ol class='flex items-center justify-center space-x-2 text-sm'>
            <li>
              <a href='/' class='text-primary-600 hover:text-primary-700'
                >Inicio</a>
            </li>
            <li class='text-gray-400'>/</li>
            <li>
              <a
                href='/productos/'
                class='text-primary-600 hover:text-primary-700'>Productos</a>
            </li>
            <li class='text-gray-400'>/</li>
            <li class='text-gray-600'>Cocina</li>
          </ol>
        </nav>

        <h1 class='text-4xl md:text-5xl font-bold text-gray-900 mb-4'>
          Productos de cocina saludable
        </h1>
        <p class='text-xl text-gray-600 max-w-2xl mx-auto'>
          Transforma tu cocina con productos libres de tóxicos y diseñados para
          una alimentación más saludable
        </p>
      </div>
    </div>
  </div>

  <div class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12'>
    <!-- Filtros y subcategorías -->
    <div class='mb-8'>
      <h2 class='text-2xl font-bold text-gray-900 mb-4'>
        Categorías de cocina
      </h2>
      <div class='flex flex-wrap gap-2 mb-6'>
        <span
          class='bg-primary-100 text-primary-800 px-4 py-2 rounded-full text-sm font-medium'
        >
          Todos los productos
        </span>
        {
          subcategories.map((subcat) => (
            <a
              href={`/productos/cocina/${subcat.slug}/`}
              class='bg-gray-100 hover:bg-gray-200 text-gray-800 px-4 py-2 rounded-full text-sm font-medium transition-colors'
            >
              {subcat.name} ({subcat.count})
            </a>
          ))
        }
      </div>
    </div>

    <!-- Productos destacados -->
    {
      cocinaProducts.filter((p) => p.featured).length > 0 && (
        <section class='mb-12'>
          <h2 class='text-2xl font-bold text-gray-900 mb-6'>
            Productos destacados
          </h2>
          <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-8'>
            {cocinaProducts
              .filter((p) => p.featured)
              .map((product) => (
                <ProductCard product={product} />
              ))}
          </div>
        </section>
      )
    }

    <!-- Todos los productos -->
    <section>
      <h2 class='text-2xl font-bold text-gray-900 mb-6'>
        Todos los productos de cocina
        <span class='text-lg font-normal text-gray-600'
          >({cocinaProducts.length} productos)</span
        >
      </h2>

      <div
        class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8'
      >
        {cocinaProducts.map((product) => <ProductCard product={product} />)}
      </div>
    </section>

    <!-- Información adicional -->
    <section class='mt-16 bg-secondary-50 rounded-lg p-8'>
      <h3 class='text-2xl font-bold text-gray-900 mb-4'>
        ¿Por qué elegir productos de cocina saludable?
      </h3>
      <div class='grid grid-cols-1 md:grid-cols-2 gap-8'>
        <div>
          <h4 class='text-lg font-semibold text-gray-900 mb-2'>
            🚫 Sin químicos tóxicos
          </h4>
          <p class='text-gray-600'>
            Libres de PFOA, PTFE, BPA y otros químicos que pueden ser
            perjudiciales para la salud.
          </p>
        </div>
        <div>
          <h4 class='text-lg font-semibold text-gray-900 mb-2'>
            🌱 Materiales naturales
          </h4>
          <p class='text-gray-600'>
            Fabricados con materiales como cerámica, hierro fundido, acero
            inoxidable y bambú.
          </p>
        </div>
        <div>
          <h4 class='text-lg font-semibold text-gray-900 mb-2'>
            💪 Mayor durabilidad
          </h4>
          <p class='text-gray-600'>
            Productos de alta calidad que duran más tiempo y mantienen su
            rendimiento.
          </p>
        </div>
        <div>
          <h4 class='text-lg font-semibold text-gray-900 mb-2'>
            🍳 Mejor sabor
          </h4>
          <p class='text-gray-600'>
            Los materiales naturales no alteran el sabor de los alimentos y
            mejoran la cocción.
          </p>
        </div>
      </div>
    </section>

    <!-- Call to action -->
    <section class='mt-16 text-center'>
      <div class='bg-gray-900 text-white rounded-2xl p-8'>
        <h3 class='text-2xl font-bold mb-4'>¿Necesitas ayuda para elegir?</h3>
        <p class='text-gray-300 mb-6 max-w-2xl mx-auto'>
          Lee nuestros artículos sobre cocina saludable o contáctanos para
          recibir recomendaciones personalizadas
        </p>
        <div class='flex flex-col sm:flex-row gap-4 justify-center'>
          <a
            href='/blog/cocina/'
            class='bg-primary-600 hover:bg-primary-700 text-white font-semibold py-3 px-6 rounded-lg transition-colors'
          >
            Leer artículos de cocina
          </a>
          <a
            href='/contacto/'
            class='bg-transparent hover:bg-white hover:text-gray-900 text-white font-semibold py-3 px-6 rounded-lg border border-white transition-colors'
          >
            Contactar para asesoramiento
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
