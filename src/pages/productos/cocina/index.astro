---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductCard from '../../../components/ProductCard.astro';
import {
  getProductsByCategory,
  getSubcategoriesByCategory,
} from '../../../utils/content';

// Cargar productos de cocina desde JSON
const cocinaProducts = await getProductsByCategory('cocina');

// Cargar subcategorías dinámicamente
const subcategories = await getSubcategoriesByCategory('cocina');
---

<BaseLayout
  title='Productos de Cocina Saludable - LDTx'
  description='Descubre nuestra selección de productos de cocina saludable: sartenes sin teflón, electrodomésticos libres de BPA, utensilios seguros y más.'
>
  <div class='bg-secondary-50 py-12'>
    <div class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8'>
      <div class='text-center'>
        <nav class='mb-4'>
          <ol class='flex items-center justify-center space-x-2 text-sm'>
            <li>
              <a href='/' class='text-primary-600 hover:text-primary-700'
                >Inicio</a
              >
            </li>
            <li class='text-gray-400'>/</li>
            <li>
              <a
                href='/productos/'
                class='text-primary-600 hover:text-primary-700'>Productos</a
              >
            </li>
            <li class='text-gray-400'>/</li>
            <li class='text-gray-600'>Cocina</li>
          </ol>
        </nav>

        <h1 class='text-4xl md:text-5xl font-bold text-gray-900 mb-4'>
          Productos de cocina saludable
        </h1>
        <p class='text-xl text-gray-600 max-w-2xl mx-auto'>
          Transforma tu cocina con productos libres de tóxicos y diseñados para
          una alimentación más saludable
        </p>
      </div>
    </div>
  </div>

  <div class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12'>
    <!-- Filtros y subcategorías -->
    <div class='mb-8'>
      <h2 class='text-2xl font-bold text-gray-900 mb-4'>
        Categorías de cocina
      </h2>
      <div class='flex flex-wrap gap-2 mb-6'>
        <span
          class='bg-primary-100 text-primary-800 px-4 py-2 rounded-full text-sm font-medium'
        >
          Todos los productos
        </span>
        {
          subcategories.map((subcat) => (
            <a
              href={`/productos/cocina/${subcat.slug}/`}
              class='bg-gray-100 hover:bg-gray-200 text-gray-800 px-4 py-2 rounded-full text-sm font-medium transition-colors'
            >
              {subcat.name} ({subcat.count})
            </a>
          ))
        }
      </div>
    </div>

    <!-- Productos destacados -->
    {
      cocinaProducts.filter((p) => p.featured).length > 0 && (
        <section class='mb-12'>
          <h2 class='text-2xl font-bold text-gray-900 mb-6'>
            Productos destacados
          </h2>
          <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-8'>
            {cocinaProducts
              .filter((p) => p.featured)
              .map((product) => (
                <ProductCard product={product} />
              ))}
          </div>
        </section>
      )
    }

    <!-- Todos los productos -->
    <section>
      <h2 class='text-2xl font-bold text-gray-900 mb-6'>
        Todos los productos de cocina
        <span class='text-lg font-normal text-gray-600'
          >({cocinaProducts.length} productos)</span
        >
      </h2>

      <div
        class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8'
      >
        {cocinaProducts.map((product) => <ProductCard product={product} />)}
      </div>
    </section>

    <!-- Información adicional -->
    <section class='mt-16 bg-secondary-50 rounded-lg p-8'>
      <h3 class='text-2xl font-bold text-gray-900 mb-4'>
        ¿Por qué elegir productos de cocina saludable?
      </h3>
      <div class='grid grid-cols-1 md:grid-cols-2 gap-8'>
        <div>
          <h4 class='text-lg font-semibold text-gray-900 mb-2'>
            🚫 Sin químicos tóxicos
          </h4>
          <p class='text-gray-600'>
            Libres de PFOA, PTFE, BPA y otros químicos que pueden ser
            perjudiciales para la salud.
          </p>
        </div>
        <div>
          <h4 class='text-lg font-semibold text-gray-900 mb-2'>
            🌱 Materiales naturales
          </h4>
          <p class='text-gray-600'>
            Fabricados con materiales como cerámica, hierro fundido, acero
            inoxidable y bambú.
          </p>
        </div>
        <div>
          <h4 class='text-lg font-semibold text-gray-900 mb-2'>
            💪 Mayor durabilidad
          </h4>
          <p class='text-gray-600'>
            Productos de alta calidad que duran más tiempo y mantienen su
            rendimiento.
          </p>
        </div>
        <div>
          <h4 class='text-lg font-semibold text-gray-900 mb-2'>
            🍳 Mejor sabor
          </h4>
          <p class='text-gray-600'>
            Los materiales naturales no alteran el sabor de los alimentos y
            mejoran la cocción.
          </p>
        </div>
      </div>
    </section>

    <!-- Call to action -->
    <section class='mt-16 text-center'>
      <div class='bg-gray-900 text-white rounded-2xl p-8'>
        <h3 class='text-2xl font-bold mb-4'>¿Necesitas ayuda para elegir?</h3>
        <p class='text-gray-300 mb-6 max-w-2xl mx-auto'>
          Lee nuestros artículos sobre cocina saludable o contáctanos para
          recibir recomendaciones personalizadas
        </p>
        <div class='flex flex-col sm:flex-row gap-4 justify-center'>
          <a
            href='/blog/cocina/'
            class='bg-primary-600 hover:bg-primary-700 text-white font-semibold py-3 px-6 rounded-lg transition-colors'
          >
            Leer artículos de cocina
          </a>
          <a
            href='/contacto/'
            class='bg-transparent hover:bg-white hover:text-gray-900 text-white font-semibold py-3 px-6 rounded-lg border border-white transition-colors'
          >
            Contactar para asesoramiento
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
